rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && (request.auth.token.get('admin', false) == true || request.auth.token.get('role', '') == 'authority'); }
    function operator() { return signedIn() && (admin() || request.auth.token.get('role', '') in ['field_officer', 'driver', 'analyst']); }
    function owner(id) { return signedIn() && request.auth.uid == id; }
    function validId(id) { return id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$'); }
    match /test/connection { allow get: if true; }
    // Admin claims and registry entries may only be provisioned by a trusted server.
    match /admins/{id} {
      allow get: if owner(id) || admin();
      allow list: if admin();
      allow write: if false;
    }
    match /users/{id} {
      allow get: if owner(id) || admin();
      allow list: if admin();
      allow create: if owner(id) && validId(id)
        && request.resource.data.keys().hasOnly(['id', 'name', 'email', 'phone', 'avatar', 'updatedAt'])
        && request.resource.data.id == id
        && request.resource.data.email == request.auth.token.email;
      allow update: if owner(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'avatar', 'updatedAt']);
      allow delete: if admin();
    }
    match /{collection}/{id} {
      allow read: if operator() && collection in ['roads', 'vehicles', 'deliveries', 'incidents', 'alerts', 'weather', 'newsArticles', 'cloudSyncMeta'];
      // Operational writes go through the validated API; only authorities can sync snapshots.
      allow create, update: if admin() && validId(id) && collection in ['roads', 'vehicles', 'deliveries', 'incidents', 'alerts', 'weather', 'newsArticles', 'cloudSyncMeta'];
      allow delete: if admin() && collection in ['roads', 'vehicles', 'deliveries', 'incidents', 'alerts', 'weather', 'newsArticles', 'cloudSyncMeta'];
    }
    match /auditLogs/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
